{
  "name": "itime-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host localhost",
    "test:e2e": "playwright test",
    "test:e2e:deepseek": "playwright test --config playwright.deepseek.config.ts",
    "test:e2e:performance": "playwright test --config playwright.performance.config.ts",
    "test:e2e:recovery": "playwright test --config playwright.recovery.config.ts"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@fontsource/roboto": "^5.3.0",
    "dompurify": "^3.4.16",
    "element-plus": "^2.14.7",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^15.0.2",
    "material-symbols": "^0.48.1",
    "qrcode.vue": "^3.7.0",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.1"
  }
}
