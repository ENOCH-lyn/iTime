# 复制为 .env.prod 后填写；.env.prod 已被 .gitignore 忽略，绝不能提交。
# 所有 ITIME_* 值最终由服务端 Pydantic 校验；生产环境强制 HTTPS 与独立密钥。

ITIME_ENVIRONMENT=production
ITIME_DATABASE_URL=postgresql+psycopg://itime:CHANGE_ME@db:5432/itime
# Cloudflare Tunnel 分配的公网域名（必须 https，无路径/凭据）
ITIME_PUBLIC_ORIGIN=https://itime.example.com
# 必须是 JSON 数组；加入公网域名、本机回环
ITIME_ALLOWED_HOSTS=["itime.example.com","localhost","127.0.0.1"]

# 四个互相独立、稳定的 Fernet 密钥；生成方式：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ITIME_ENCRYPTION_KEY=
ITIME_AI_ENCRYPTION_KEY=
ITIME_CALENDAR_SUBSCRIPTION_ENCRYPTION_KEY=
ITIME_EXPORT_ENCRYPTION_KEY=

# 与 compose.prod.yaml 的 db 服务保持一致
POSTGRES_PASSWORD=CHANGE_ME

# 可选：真实 SMTP（生产外部 SMTP 必须 STARTTLS）
# ITIME_SMTP_HOST=smtp.example.com
# ITIME_SMTP_PORT=587
# ITIME_SMTP_STARTTLS=true
# ITIME_SMTP_USERNAME=
# ITIME_SMTP_PASSWORD=
# ITIME_SMTP_FROM=iTime <no-reply@example.com>
