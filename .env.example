# 开发时使用 python3 scripts/bootstrap.py 创建 .env.local。
# 此文件只记录配置名，不存放真实密码。
POSTGRES_PASSWORD=replace-with-local-random-secret
POSTGRES_PORT=55432
SMTP_PORT=51025
MAILPIT_PORT=58025
ITIME_ENVIRONMENT=development
ITIME_DATABASE_URL=postgresql+psycopg://itime:replace-with-local-random-secret@127.0.0.1:55432/itime
ITIME_PUBLIC_ORIGIN=http://localhost:5173
ITIME_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
# 由 bootstrap 生成；独立于数据库保管，不要在轮换时直接丢弃旧密钥。
ITIME_ENCRYPTION_KEY=generate-with-scripts-bootstrap.py
# 生产环境必须分别生成；开发环境未配置时暂回退到基础密钥。
ITIME_AI_ENCRYPTION_KEY=generate-a-different-fernet-key
ITIME_CALENDAR_SUBSCRIPTION_ENCRYPTION_KEY=generate-another-fernet-key
ITIME_EXPORT_ENCRYPTION_KEY=generate-a-fourth-fernet-key
ITIME_SESSION_HOURS=720
ITIME_ADMIN_SESSION_HOURS=8
ITIME_ADMIN_SETUP_MINUTES=30
ITIME_AI_JOB_LEASE_SECONDS=210
ITIME_AI_BODY_LOG_RETENTION_DAYS=7
ITIME_AI_QUALITY_SAMPLE_RETENTION_DAYS=30
ITIME_CALENDAR_SUBSCRIPTION_LEASE_SECONDS=60
ITIME_EXPORT_JOB_LEASE_SECONDS=120
ITIME_EXPORT_ARTIFACT_RETENTION_HOURS=24
ITIME_EXPORT_JOB_RETENTION_DAYS=30
ITIME_EXPORT_MAX_UNCOMPRESSED_BYTES=104857600
ITIME_EXPORT_MAX_ARCHIVE_BYTES=52428800
ITIME_VERIFICATION_MINUTES=30
ITIME_PASSWORD_RESET_MINUTES=15
ITIME_MAIL_COOLDOWN_SECONDS=60
ITIME_SMTP_HOST=127.0.0.1
ITIME_SMTP_PORT=51025
ITIME_SMTP_STARTTLS=false
ITIME_SMTP_FROM=iTime <account@itime.local>
